// Local settings for `dotnet run`. Copy to appsettings.Local.json (git-ignored) and fill in the empty values.
// Docker reads the same values from .env instead (see env.example).
{
  // Only change the password if you set POSTGRES_PASSWORD before the database volume was first created.
  "ConnectionStrings": {
    "Db": "Host=localhost;Port=5432;Database=routepoi;Username=routepoi;Password=routepoi"
  },
  // Google OAuth client for app sign-in. Authorized redirect URI: http://localhost:5080/auth/google-callback
  "Google": {
    "ClientId": "",
    "ClientSecret": ""
  },
  // From https://apizone.suunto.com (your profile page). The API refuses to start without these three.
  // OAuth redirect URI in your API Zone settings must be exactly: http://localhost:5080/auth/callback
  "Suunto": {
    "Mode": "Live",
    // Profile → OAuth settings: "Client Id".
    "ClientId": "",
    // Profile → OAuth settings: the client secret you set there.
    "ClientSecret": "",
    // Profile → Your subscriptions → Developer API: primary (or secondary) key.
    "SubscriptionKey": "",
    // Logs the shape of Suunto responses (never tokens or keys) while verifying the live API.
    "DiagnosticLogging": false
  }
}
