{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "App": {
    "PublicBaseUrl": "http://localhost:5080",
    "RequireOAuthState": true
  },
  "Auth": {
    "AllowedGoogleEmails": "",
    "AllowedSuuntoUsernames": "",
    "SessionLifetime": "60.00:00:00",
    "SessionRevalidationInterval": "00:05:00"
  },
  "Admin": {
    "GoogleEmails": "",
    "SuuntoUsernames": ""
  },
  "Google": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "Hosting": {
    "ForwardedHeaders": false,
    "TrustedProxies": "",
    "Hsts": false,
    "RateLimit": {
      "Enabled": true,
      "PerMinute": 600,
      "ExternalPerMinute": 120,
      "AuthPerMinute": 30
    }
  },
  "Uploads": {
    "MaxFileSizeMb": 20
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "ConnectionStrings": {
    "Db": "Host=localhost;Port=5432;Database=routepoi;Username=routepoi;Password=routepoi"
  },
  "Suunto": {
    "Mode": "Live",
    "ClientId": "",
    "ClientSecret": "",
    "SubscriptionKey": "",
    "AuthorizeBaseUrl": "https://cloudapi-oauth.suunto.com",
    "OAuthBaseUrl": "https://cloudapi-oauth.suunto.com",
    "ApiBaseUrl": "https://cloudapi.suunto.com",
    "RedirectUri": "http://localhost:5080/auth/callback"
  }
}
