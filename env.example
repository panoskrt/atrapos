# Copy to .env (git-ignored) and fill in from https://apizone.suunto.com (your profile page).
# The redirect URI in your API Zone OAuth settings must be exactly: http://localhost:5080/auth/callback

SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_SUBSCRIPTION_KEY=

# Google OAuth client for app sign-in. Register http://localhost:5080/auth/google-callback
# as an authorized redirect URI for local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
# SUUNTO_DIAGNOSTICS=true     # log Suunto response shapes (no secrets) while verifying the API
# REQUIRE_OAUTH_STATE=true    # set false only if Suunto turns out not to echo the OAuth state
# POSTGRES_PASSWORD=routepoi  # only before the database volume is first created
